@startuml c4-container
!include <C4/C4_Container>

LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()

title Container diagram – BrewLite (C2)

Person(customer, "Customer", "Khách hàng đặt và thanh toán đồ uống")
Person(admin, "Admin", "Nhân viên quầy / Quản lý cửa hàng")

System_Boundary(brewlite, "BrewLite PWA (monorepo: apps/web, apps/api)") {
    Container(web, "Frontend", "Next.js, PWA, port 3000", "Giao diện mobile-first: menu, giỏ hàng, checkout, lịch sử và theo dõi đơn, màn hình Admin")
    Container(api, "Backend", "NestJS REST API, port 3001", "Xác thực JWT, validate, nghiệp vụ đơn hàng, tồn kho, thanh toán, health check")
    ContainerDb(db, "Database", "PostgreSQL 16, port 5432, Docker", "Lưu người dùng, sản phẩm, đơn hàng, thanh toán; schema qua migration")
}

System_Ext(payment, "Mock Payment Service", "Dịch vụ thanh toán mô phỏng Ví/Thẻ")

Rel(customer, web, "Truy cập menu, đặt đơn", "HTTPS")
Rel(admin, web, "Quản lý đơn hàng", "HTTPS")
Rel(web, api, "Gọi API", "REST, JSON/HTTPS, Bearer JWT")
Rel(api, db, "Đọc/ghi dữ liệu", "Prisma Client, TCP 5432")
Rel(api, payment, "Yêu cầu thanh toán kèm Idempotency-Key", "HTTPS, JSON")

@enduml
